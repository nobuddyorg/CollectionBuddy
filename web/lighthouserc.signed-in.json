{
  "ci": {
    "collect": {
      "url": ["http://127.0.0.1:4173/CollectionBuddy/"],
      "startServerCommand": "node scripts/serve-export.mjs 4173 /CollectionBuddy",
      "startServerReadyPattern": "Accepting connections",
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": ["performance", "best-practices", "seo"],
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.65 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 7000 }],
        "total-blocking-time": ["error", { "maxNumericValue": 600 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.4 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-reports/signed-in"
    }
  }
}
