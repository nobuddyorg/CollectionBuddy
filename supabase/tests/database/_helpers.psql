-- Shared pg_temp fixtures, \ir-included; .psql because pg_prove collects every .sql file here as a test.

-- A real token's sub names an Auth user, and every owner column references one (0034); SET ROLE is refused inside a definer, hence two functions.
create or replace function pg_temp.ensure_auth_user(p_user_id uuid, p_email text)
returns void
language sql
security definer
as $$
  insert into auth.users (id, email) values (p_user_id, p_email) on conflict do nothing
$$;

-- A caller as PostgREST sees one (role + JWT claims); a NULL email is a token with no email claim. 005 proves it.
create or replace function pg_temp.auth_as(p_user_id uuid, p_email text default null)
returns void
language plpgsql
as $$
begin
  perform pg_temp.ensure_auth_user(p_user_id, p_email);
  set local role authenticated;
  perform set_config(
    'request.jwt.claims',
    jsonb_build_object('sub', p_user_id::text, 'email', p_email, 'role', 'authenticated')::text,
    true
  );
end;
$$;

-- A visitor with no session at all: the anon role, and no claims.
create or replace function pg_temp.auth_as_anon()
returns void
language plpgsql
as $$
begin
  set local role anon;
  perform set_config('request.jwt.claims', '', true);
end;
$$;

-- An upload as the Storage API writes it; assert it with lives_ok() or throws_ok(), never an any-error check.
create or replace function pg_temp.upload_statement(p_path text)
returns text
language sql
immutable
as $$
  select format('insert into storage.objects (bucket_id, name) values (%L, %L)', 'item-images', p_path)
$$;

-- Rows one write would touch, always rolled back; keep a probe inline when a later read-back (TEST_STRATEGY.md §7 rule 5) must see it.
create or replace function pg_temp.rows_written(p_sql text)
returns bigint
language plpgsql
as $$
declare
  touched bigint;
begin
  execute format('with attempt as (%s) select count(*) from attempt', p_sql) into touched;
  raise exception using errcode = 'UNDO0';
exception when sqlstate 'UNDO0' then
  return touched;
end
$$;

-- Files an entry into one more collection past trg_item_categories_quota, a shape only rows from before 0020 have.
create or replace function pg_temp.file_as_before_0020(p_item_id uuid, p_category_id uuid)
returns void
language plpgsql
as $$
begin
  reset role;
  alter table public.item_categories disable trigger trg_item_categories_quota;
  set local role authenticated;
  insert into public.item_categories (item_id, category_id) values (p_item_id, p_category_id);
  reset role;
  alter table public.item_categories enable trigger trg_item_categories_quota;
  set local role authenticated;
end;
$$;

-- True for an object an extension owns (pg_depend deptype 'e'), excluded from the schema-wide catalog checks.
create or replace function pg_temp.is_extension_member(p_oid oid)
returns boolean
language sql
stable
as $$
  select exists (select 1 from pg_catalog.pg_depend d where d.objid = p_oid and d.deptype = 'e')
$$;
